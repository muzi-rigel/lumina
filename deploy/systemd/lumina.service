[Unit]
Description=Lumina A-Share Monitoring Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=lumina
Group=lumina
WorkingDirectory=/opt/lumina
Environment=PYTHONUNBUFFERED=1
Environment=LUMINA_LOG_DIR=/var/log/lumina
EnvironmentFile=-/etc/lumina/lumina.env
ExecStart=/opt/lumina/.venv/bin/lumina --settings /etc/lumina/settings.yaml --stocks /etc/lumina/stocks.yaml --rules /etc/lumina/rules.yaml

Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
KillSignal=SIGTERM

StateDirectory=lumina
LogsDirectory=lumina
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
